# The GmLeads widget bundle. Defaults to the live Cloudflare Pages build
# if unset (see gmleads-widget/README.md) — the aspirational cdn.gmleads.io
# domain isn't provisioned yet. Change here, not in code, once it is.
NEXT_PUBLIC_WIDGET_URL=https://gmleads-widget-production.pages.dev/widget.js

# The embed key for the dedicated "GmLeads Demo" workspace (production).
# Not the same workspace used for infrastructure smoke tests — see
# gmleads-agents/context/ for how that workspace was created.
NEXT_PUBLIC_EMBED_KEY=
