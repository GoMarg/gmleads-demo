# GmLeads Demo Environment Variables

# Widget Configuration
NEXT_PUBLIC_WIDGET_URL=https://gmleads-widget-production.pages.dev/widget.js
NEXT_PUBLIC_EMBED_KEY=your_embed_key_here
NEXT_PUBLIC_DEMO_EMBED_KEY=your_demo_embed_key_here

# Backend Gateway
GATEWAY_URL=http://localhost:3000

# Demo Admin Credentials
DEMO_ADMIN_EMAIL=admin@gmleads.com
DEMO_ADMIN_PASSWORD=your_demo_password_here

# Slack OAuth Integration
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Redirect URL for Slack OAuth: http://localhost:3000/api/slack/callback