# GmLeads Demo — Environment Variables
# Copy this file to .env.local and fill in the values.

# Required: The embed key for the GmLeads Demo workspace.
# You can find this in the GmLeads dashboard or generate one via the API.
NEXT_PUBLIC_DEMO_EMBED_KEY=

# Optional: Override the widget script URL.
# Defaults to the Cloudflare Pages production build.
NEXT_PUBLIC_WIDGET_URL=https://gmleads-widget-production.pages.dev/widget.js

# Optional: GmLeads widget embed key for the default (env var) widget instance.
# If unset, the widget only loads when a dynamic key is provided.
NEXT_PUBLIC_EMBED_KEY=

# Server-side: Gateway URL for backend API calls.
# Defaults to http://localhost:3000 for local development.
GATEWAY_URL=http://localhost:3000

# Server-side: Admin credentials for workspace creation.
# Used by the /api/generate-embed server-side route only.
# These are NEVER exposed to the browser.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

